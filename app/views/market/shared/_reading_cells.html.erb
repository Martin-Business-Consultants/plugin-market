<%# locals: (reading:) %>
<%# A website's latest reading as comparison cells: pages, posts, locations, services, updated, then the tools by column, then socials. %>
<% if reading&.read? %>
  <td><%= market_figure reading, :pages %></td>
  <td><%= market_figure reading, :posts %> <span class="txt-x-small txt-subtle">(<%= reading.figure(:posts_last_90_days) || 0 %>)</span></td>
  <td><%= market_figure reading, :locations %></td>
  <td><%= market_figure reading, :services %></td>
  <td class="txt-nowrap"><%= market_figure reading, :last_changed %></td>
  <% Market::MarketHelper::MARKET_COLUMNS.each_value.with_index do |keys, index| %>
    <%# herb:key index %>
    <td><%= market_tool_dots reading, keys %></td>
  <% end %>
  <td><%= reading.socials.size %></td>
<% else %>
  <td colspan="<%= 6 + Market::MarketHelper::MARKET_COLUMNS.size %>" class="txt-small txt-subtle"><%= reading ? "Couldn't be read: #{reading.error}" : "Not read yet" %></td>
<% end %>
