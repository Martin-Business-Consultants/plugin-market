<% @page_title = "Edit #{@competitor.name}" %>
<% content_for :header do %>
  <%= parent_page @competitor.name, market_competitor_path(@competitor) %>
<% end %>
<%= render "market/nav", current: :competitors %>

<section class="settings">
  <div class="settings__panel panel shadow txt-align-start">
    <h1 class="page-title"><%= @page_title %></h1>
    <%= render "market/competitors/form", competitor: @competitor %>
  </div>
</section>
