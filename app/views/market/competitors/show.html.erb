<% @page_title = @competitor.name %>
<% content_for :header do %>
  <%= parent_page "Competitors", market_competitors_path %>
<% end %>
<%= render "market/nav", current: :competitors %>
<% reading = @snapshots.first %>

<section class="panel shadow txt-align-start market-card">
  <div class="page-heading">
    <h1 class="page-title"><%= @competitor.name %></h1>
    <div class="page-heading__actions">
      <% if can?(:manage_market) && @competitor.domain %>
        <%= button_to market_competitor_check_path(@competitor), class: "btn btn--circle-mobile", form_class: "display-contents" do %>
          <%= icon_tag "refresh" %> <span>Read again</span>
        <% end %>
      <% end %>
      <% if can?(:manage_market) %>
        <%= link_to edit_market_competitor_path(@competitor), class: "btn btn--circle-mobile", data: { keys: "e" } do %>
          <%= icon_tag "pencil" %> <span>Edit</span> <kbd class="hide-on-touch">E</kbd>
        <% end %>
      <% end %>
    </div>
  </div>
  <div class="record-meta txt-small">
    <% if @competitor.website %>
      <%= link_to @competitor.host, @competitor.website, class: "txt-link", target: "_blank", rel: "noopener" %>
    <% end %>
    <% if @competitor.industry %>
      <%= link_to @competitor.industry.name, market_industry_path(@competitor.industry), class: "txt-link" %>
    <% end %>
    <span class="txt-subtle"><%= market_checked_text reading %></span>
  </div>

  <dl class="record-facts txt-small">
    <dt>Against</dt>
    <dd>
      <% if @rivalries.any? %>
        <ul class="market-plain-list">
          <% @rivalries.each do |rivalry| %>
            <%# herb:key rivalry.id %>
            <li class="market-tags">
              <%= link_to rivalry.client.name, market_client_path(rivalry.client, anchor: "competitors"), class: "txt-link" %>
              <span class="txt-x-small txt-subtle"><%= rivalry.kind_label %></span>
              <%= market_threat_tag rivalry %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <span class="txt-subtle">No <%= term(:client).downcase %> yet: add it from a <%= term(:client).downcase %>'s market page.</span>
      <% end %>
    </dd>
    <% [ [ "What they do well", @competitor.strengths ], [ "Where they're weak", @competitor.weaknesses ], [ "Notes", @competitor.notes ] ].each do |label, value| %>
      <%# herb:key label %>
      <% next if value.blank? %>
      <dt><%= label %></dt>
      <dd class="market-text"><%= value %></dd>
    <% end %>
  </dl>
</section>

<% if reading %>
  <% home = reading.home %>
  <% sitemap = reading.sitemap %>
  <% tools = market_tool_labels(reading) %>
  <div class="market-columns">
    <section class="panel shadow txt-align-start market-card">
      <header class="market-card__header">
        <h2 class="market-card__title">Their home page</h2>
        <span class="txt-x-small txt-subtle"><%= l reading.taken_at.to_date, format: :long %></span>
      </header>
      <% if home.any? %>
        <dl class="record-facts txt-small">
          <% if home["title"] %><dt>Title</dt><dd><%= home["title"] %></dd><% end %>
          <% if home["description"] %><dt>Description</dt><dd><%= home["description"] %></dd><% end %>
          <% if Array(home["headings"]).any? %><dt>Main heading</dt><dd><%= home["headings"].first %></dd><% end %>
          <% if home["platform"] %><dt>Built on</dt><dd><%= home["platform"] %></dd><% end %>
          <dt>Runs</dt>
          <% if tools.any? %>
            <dd><%= tools.to_sentence %></dd>
          <% else %>
            <dd class="txt-subtle">Nothing we recognise</dd>
          <% end %>
          <% if home["socials"].present? %>
            <dt>Socials</dt>
            <dd class="market-tags">
              <% home["socials"].each do |network, url| %>
                <%# herb:key network %>
                <%= link_to Market::Probe::SOCIAL_LABELS.fetch(network, network.humanize), url, class: "txt-link", target: "_blank", rel: "noopener" %>
              <% end %>
            </dd>
          <% end %>
          <% if Array(home["schema_types"]).any? %><dt>Structured data</dt><dd><%= home["schema_types"].join(", ") %></dd><% end %>
          <% if Array(home["phone_numbers"]).any? %><dt>Phone</dt><dd><%= home["phone_numbers"].join(", ") %></dd><% end %>
          <% if home["words"] %><dt>Words</dt><dd><%= number_with_delimiter home["words"] %></dd><% end %>
        </dl>
      <% else %>
        <p class="txt-small txt-subtle margin-none">Couldn't be read: <%= reading.facts.dig("home_page", "error") %></p>
      <% end %>
    </section>

    <section class="panel shadow txt-align-start market-card">
      <header class="market-card__header"><h2 class="market-card__title">Their site</h2></header>
      <% if sitemap.any? %>
        <dl class="record-facts txt-small">
          <dt>Pages</dt><dd><%= number_with_delimiter sitemap["pages"] %></dd>
          <dt>Posts</dt><dd><%= sitemap["posts"] %> <span class="txt-subtle">(<%= sitemap["posts_last_90_days"] %> in the last 90 days)</span></dd>
          <dt>Location pages</dt><dd><%= sitemap["locations"] %></dd>
          <dt>Service pages</dt><dd><%= sitemap["services"] %></dd>
          <% if sitemap["last_changed"] %><dt>Last changed</dt><dd><%= l Date.parse(sitemap["last_changed"]), format: :long %></dd><% end %>
        </dl>
        <% if reading.partial_sitemap? %>
          <p class="txt-x-small txt-subtle margin-none">Counted from the first <%= sitemap["sitemaps_read"] %> of its <%= sitemap["sitemaps"] %> sitemaps, so these are at least what it has.</p>
        <% end %>
        <% if Array(sitemap["sample"]).any? %>
          <details class="market-closed">
            <summary class="txt-small">Some of its pages</summary>
            <ul class="market-plain-list txt-x-small">
              <% sitemap["sample"].each_with_index do |url, index| %>
                <%# herb:key index %>
                <li><%= link_to url, url, class: "txt-link", target: "_blank", rel: "noopener" %></li>
              <% end %>
            </ul>
          </details>
        <% end %>
      <% else %>
        <p class="txt-small txt-subtle margin-none">No sitemap found: <%= reading.facts.dig("sitemap", "error") %></p>
      <% end %>
    </section>
  </div>
<% end %>

<section class="panel shadow txt-align-start market-card">
  <header class="market-card__header">
    <h2 class="market-card__title">What changed</h2>
    <span class="txt-x-small txt-subtle">Read every week</span>
  </header>
  <% changed = @snapshots.select { it.differences.any? } %>
  <% if changed.any? %>
    <ul class="market-list">
      <% changed.each do |snapshot| %>
        <%# herb:key snapshot.id %>
        <li class="market-list__row market-list__row--stacked">
          <span class="font-weight-bold txt-small"><%= l snapshot.taken_at.to_date, format: :long %></span>
          <ul class="market-changes txt-small">
            <% snapshot.differences.each_with_index do |change, index| %>
              <%# herb:key index %>
              <li><%= change %></li>
            <% end %>
          </ul>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="txt-small txt-subtle margin-none"><%= @snapshots.size > 1 ? "Nothing yet, over #{pluralize(@snapshots.size, "reading")}." : "Changes show here from the second reading on." %></p>
  <% end %>
</section>
