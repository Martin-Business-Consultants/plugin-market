<% @page_title = "#{@client.name}'s market" %>

<% content_for :header do %>
  <%= parent_page @client.name, market_client_path(@client) %>
<% end %>
<%= render "market/nav", current: :clients %>

<section class="settings">
  <div class="settings__panel panel shadow txt-align-start">
    <h1 class="page-title"><%= @page_title %></h1>
    <%= render "market/profiles/form", profile: @profile %>
  </div>
</section>
