<% @page_title = "Opportunities" %>
<%= render "market/nav", current: :opportunities %>

<% content_for :index_filters do %>
  <%= render "layouts/shared/quick_filter", title: "Show…", param: :state, current: @state,
        options: [ [ "Open (#{@counts["open"].to_i})", "open" ], [ "Planned (#{@counts["planned"].to_i})", "planned" ], [ "Open or planned", "active" ],
                   [ "Done (#{@counts["done"].to_i})", "done" ], [ "Dismissed (#{@counts["dismissed"].to_i})", "dismissed" ], [ "All", "all" ] ] %>
  <%= render "layouts/shared/quick_filter", title: "Channel…", param: :channel, current: @channel.to_s,
        options: [ [ "Every channel", "" ] ] + Market::Opportunity::CHANNELS.map { [ it.last, it.first ] } %>
  <%= render "layouts/shared/quick_filter", title: "When…", param: :horizon, current: @horizon.to_s,
        options: [ [ "Any time", "" ] ] + Market::Opportunity::HORIZONS.map { [ it.last, it.first ] } %>
  <% [ @client, @industry ].compact.each do |filter| %>
    <%# herb:key filter.class.name %>
    <%= link_to market_opportunities_path(request.query_parameters.except(filter.is_a?(Client) ? "client_id" : "industry_id")), class: "btn txt-small" do %>
      <%= icon_tag "close" %> <span><%= filter.name %></span>
    <% end %>
  <% end %>
<% end %>
<%= render "layouts/shared/index_toolbar" %>

<section class="panel shadow txt-align-start market-card">
  <% if @opportunities.any? %>
    <ul class="market-list">
      <% @opportunities.each do |opportunity| %>
        <%# herb:key opportunity.id %>
        <%= render "market/opportunities/opportunity", opportunity: opportunity, engagements: @engagements.fetch(opportunity.client_id, []), people: @people, manage: can?(:manage_market), show_client: true %>
      <% end %>
    </ul>
  <% else %>
    <p class="txt-small txt-subtle margin-none">None here. Plans drafted on <%= term(:client, count: 2).downcase %>' market pages add them, best first.</p>
  <% end %>
</section>
